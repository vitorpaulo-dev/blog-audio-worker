# Port the worker HTTP server listens on
PORT=3966

# OpenCode serve endpoint (run: opencode serve) on the worker host
OPENCODE_URL=http://localhost:4096

# Optional model for OpenCode prompt calls (provider/model), e.g. openai/gpt-4o-mini
OPENCODE_MODEL=

# Optional bearer token for the OpenCode serve API (falls back to CASE_OPENCODE_TOKEN)
OPENCODE_TOKEN=

# VoiceStudio base URL: network address of the TTS host (required)
VOICE_STUDIO_URL=http://localhost:3900

# VoiceStudio bearer token (required by the deployed instance)
VOICE_STUDIO_TOKEN=

# Voice profile ids per language: _HOST for narration and podcast host segments,
# _GUEST for podcast guest segments.
# NARRATION resolves VOICE_PROFILE_ID_{LANGUAGE}_HOST. PODCAST HOST segments resolve
# VOICE_PROFILE_ID_{LANGUAGE}_HOST; GUEST segments resolve VOICE_PROFILE_ID_{LANGUAGE}_GUEST.
# No fallback: if the required profile is empty or missing, the artifact fails with a
# voiceMissing error.
VOICE_PROFILE_ID_ENGLISH_HOST=a_a6f4d469fe
VOICE_PROFILE_ID_ENGLISH_GUEST=feat_04_the_neighbor
VOICE_PROFILE_ID_PORTUGUESE_HOST=
VOICE_PROFILE_ID_PORTUGUESE_GUEST=

# Redis connection (optional: when unset, the worker skips all Redis progress
# writes — the service falls back to the database status; network TCP only;
# password supported; no localhost default)
REDIS_URL=redis://100.64.214.3:6379
# TLS variant: REDIS_URL=rediss://:password@redis-host:6379
